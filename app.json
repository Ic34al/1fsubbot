{
  "name": "1fsubbot",
  "description": "Telegram file sharing bot",
  "formation": {
    "web": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "env": {
    "TG_BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "APP_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash",
      "required": true
    },
    "OWNER_ID": {
      "description": "Owner Telegram user ID",
      "required": true
    },
    "CHANNEL_ID": {
      "description": "Database channel ID",
      "required": true
    },
    "DATABASE_URL": {
      "description": "MongoDB connection URL",
      "required": true
    },
    "DATABASE_NAME": {
      "description": "MongoDB database name",
      "value": "filesharexbot",
      "required": false
    },
    "ADMINS": {
      "description": "Admin Telegram user IDs separated by spaces",
      "required": true
    },
    "FORCE_SUB_CHANNEL": {
      "description": "First force subscription channel ID, or 0 to disable",
      "value": "0",
      "required": false
    },
    "FORCE_SUB_CHANNEL2": {
      "description": "Second force subscription channel ID, or 0 to disable",
      "value": "0",
      "required": false
    },
    "TG_BOT_WORKERS": {
      "description": "Number of Pyrogram workers",
      "value": "8",
      "required": false
    },
    "PROTECT_CONTENT": {
      "description": "Set true to protect copied content",
      "value": "False",
      "required": false
    }
  }
}
