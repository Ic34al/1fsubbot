
{
  "name": "1fsubbot",
  "description": "Telegram file-sharing bot",
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "env": {
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API hash",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram bot token",
      "required": true
    },
    "MONGO_URI": {
      "description": "MongoDB connection string",
      "required": true
    },
    "DATABASE_NAME": {
      "description": "MongoDB database name",
      "value": "FileBot",
      "required": false
    },
    "OWNER_ID": {
      "description": "Owner Telegram user ID",
      "required": true
    },
    "CHANNEL_ID": {
      "description": "Private file database channel ID",
      "required": true
    },
    "FSUB_CHANNEL_1_ID": {
      "description": "Force-sub channel 1 ID",
      "required": true
    },
    "FSUB_CHANNEL_2_ID": {
      "description": "Force-sub channel 2 ID",
      "required": true
    },
    "FSUB_CHANNEL_3_ID": {
      "description": "Force-sub channel 3 ID",
      "required": true
    },
    "FSUB_CHANNEL_4_ID": {
      "description": "Force-sub channel 4 ID",
      "required": true
    },
    "ADMINS": {
      "description": "Additional admin IDs, comma-separated",
      "required": false
    },
    "TG_BOT_WORKERS": {
      "description": "Pyrogram worker count",
      "value": "8",
      "required": false
    },
    "PROTECT_CONTENT": {
      "description": "Protect copied files",
      "value": "False",
      "required": false
    }
  }
}
